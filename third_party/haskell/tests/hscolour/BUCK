# Links a third-party Hackage package into a real binary and runs it: proves
# the sdist -> `http_archive` -> `haskell_library` path end to end.

sh_test(
    name = "hscolour",
    test = ":main",
)

haskell_binary(
    name = "main",
    srcs = ["Main.hs"],
    deps = [
        "//third_party/haskell:base",
        "//third_party/haskell:hscolour",
    ],
)
