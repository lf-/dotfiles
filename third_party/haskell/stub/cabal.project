-- @generated by hackage2buck solve; overrides go in cabal.project.local
packages: .

-- Only libraries are ever generated; test and benchmark deps would just
-- be solved and never downloaded.
tests: False
benchmarks: False

constraints:
  , Cabal installed
  , Cabal-syntax installed
  , array installed
  , base installed
  , binary installed
  , bytestring installed
  , containers installed
  , deepseq installed
  , directory installed
  , exceptions installed
  , file-io installed
  , filepath installed
  , ghc installed
  , ghc-bignum installed
  , ghc-boot installed
  , ghc-boot-th installed
  , ghc-compact installed
  , ghc-experimental installed
  , ghc-heap installed
  , ghc-internal installed
  , ghc-platform installed
  , ghc-prim installed
  , ghc-toolchain installed
  , ghci installed
  , haddock-api installed
  , haddock-library installed
  , haskeline installed
  , hpc installed
  , integer-gmp installed
  , mtl installed
  , os-string installed
  , parsec installed
  , pretty installed
  , process installed
  , rts installed
  , semaphore-compat installed
  , stm installed
  , system-cxx-std-lib installed
  , template-haskell installed
  , template-haskell-lift installed
  , template-haskell-quasiquoter installed
  , terminfo installed
  , text installed
  , time installed
  , transformers installed
  , unix installed
  , xhtml installed
