load("@elk//:elk.bzl", "elk_packages", "uv_deps", "uv_packages")
load(":linux-x86_64.tags.json", linux_x86_64_tags = "value")
load(":linux-aarch64.tags.json", linux_aarch64_tags = "value")
load(":macos-aarch64.tags.json", macos_aarch64_tags = "value")
load(":uv.lock?as=toml", lock = "value")

elk_packages(
    packages = uv_packages(lock),
    platform_tags = {
        "linux-x86_64": linux_x86_64_tags,
        "linux-arm64": linux_aarch64_tags,
        "macos-arm64": macos_aarch64_tags,
    },
)
