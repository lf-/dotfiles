# Every `java_library` and `prebuilt_jar` wants a dex toolchain, Android or not:
# the prelude's own tools name `:empty_dex`, everything else `:dex`. Dexing needs
# the Android SDK, so both are the prelude's no-op.
system_noop_dex_toolchain(
    name = "dex",
    visibility = ["PUBLIC"],
)

system_noop_dex_toolchain(
    name = "empty_dex",
    visibility = ["PUBLIC"],
)

# Nothing of ours is Kotlin, but `jar_builder` and `zip_scrubber` are defaults on
# every java_toolchain and live in a `kotlin_library` package, so no Java builds
# without this. Takes no JDK of ours, hence not in `hermetic_java_toolchain`.
#
# Its kotlin-compiler-embeddable 2.1.0 is what caps `:java` at 24: newer JDKs
# throw in its bundled IntelliJ utils. A hermetic Kotlin was tried and dropped --
# a newer kotlinc handles the JDK but stamps `@Metadata` the prelude's ABI
# stubber (a separate 2.1.0 pin) won't read.
system_kotlin_bootstrap_toolchain(
    name = "kotlin_bootstrap",
    visibility = ["PUBLIC"],
)

# javacd's protobuf model ships as a `.src.zip`, so building the Java compiler
# needs a zip rule.
zip_file_toolchain(
    name = "zip_file",
    visibility = ["PUBLIC"],
)

