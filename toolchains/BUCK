# Upstream's analyzer discards a package's Objective-C sources; ours reports
# them. `pkg_analyzer` is a plain overridable attr on `go_toolchain` (only
# `system_go_toolchain` pins it with default_only), so this needs no prelude fork.
go_bootstrap_binary(
    name = "pkg_analyzer",
    srcs = ["pkg_analyzer.go"],
    build_args = ["pkg_analyzer.go"],
    visibility = ["PUBLIC"],
)

hermetic_go_toolchain(
