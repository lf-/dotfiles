# `system_cxx_toolchain` cannot compile Objective-C; matchlock's
# Virtualization.framework backend is written in it. See the bzl file.
objc_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "rust",
    default_edition = "2021",
    sha256s = {
        "aarch64-apple-darwin": "f04a974f3579d3524f6b9bc6490a27c9fb358050e7cd8a641945f30bf24c1dce",
        "x86_64-unknown-linux-gnu": "c295047583a56238ea06b43f849f4b877fa12bfd4c7103f8d9a74c94c9c4e108",
    },
    version = "1.96.0",
)

# Upstream's analyzer discards a package's Objective-C sources; ours reports
# them. `pkg_analyzer` is a plain overridable attr on `go_toolchain` (only
# `system_go_toolchain` pins it with default_only), so this needs no prelude fork.
go_bootstrap_binary(
    name = "pkg_analyzer",
    srcs = ["pkg_analyzer.go"],
    build_args = ["pkg_analyzer.go"],
    visibility = ["PUBLIC"],
)

