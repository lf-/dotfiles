)

# Every `genrule` wants one of these; the python toolchain has one to gather the
# libpython symbols native extensions link against. `zip_scrubber = None` is all
# the prelude's own implementation does.
system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

# Required by every prelude test rule (sh_test's private `_test_toolchain`
# attr points at `toolchains//:test`); the prelude's noop implementation.
noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

# go_test (and the other prelude test rules) also want this. With no profiles
# declared it selects local execution, which is all we can do until there is a
# remote executor to talk to.
remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(
    name = "update_hermetic_toolchain",
    main = "update_hermetic_toolchain.py",
    visibility = ["PUBLIC"],
)
