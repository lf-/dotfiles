# What `:cxx` actually invokes for every compile, archive and link: the zig
# cache, response-file flattening and target flags all live in there.
python_bootstrap_binary(
    name = "zig_wrapper",
    main = "zig_wrapper.py",
    visibility = ["PUBLIC"],
)

