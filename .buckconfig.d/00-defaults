[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# Uses a copy of the prelude bundled with the buck2 binary. You can alternatively delete this
# section and vendor a copy of the prelude to the `prelude` directory of your project.
[external_cells]
  prelude = bundled

# The default *target* platform -- what a target is built for when nothing asks
# for anything else.  See //platforms for why this is not the same thing as the
# execution platform below.
[parser]
  target_platform_detector_spec = target:root//...->root//platforms:default \
    target:prelude//...->root//platforms:default \
    target:toolchains//...->root//platforms:default \
    target:elk//...->root//platforms:default

[buck2]
declare_output_has_content_based_path_default = true
action_has_content_based_path_default = true

# rust caching :3
default_allow_cache_upload = true

# eponymous targets :3
infer_target_names = true

# RE go brr :3
defer_write_actions = true
sqlite_materializer_state = true
clean_stale_enabled = true
# one week
clean_stale_artifact_ttl_hours = 168
clean_stale_period_hours = 24
clean_stale_start_offset_hours = 12

[project]
ignore = .git, .jj, .claude

# Where actions run.  //platforms:exec lists the host first and the remote
# workers after it; `[buck2_re_client] default_mode` says how much of the RE
# stack the host itself uses.  See //platforms and .buckconfig.d/04-buildbuddy.
[build]
  execution_platforms = root//platforms:exec
